  "name": "reup · F3 ingest (async)",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "reup-ingest",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-200, 0],
      "webhookId": "b1000000-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://media-service:8001/media/jobs",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.body.url }}"
            },
            {
              "name": "callback_url",
              "value": "={{ 'http://n8n:5678/webhook-waiting/' + $execution.resumeUrl.split('/webhook-waiting/')[1] }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Start ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [20, 0],
      "notes": "The host is swapped, not the path: $execution.resumeUrl is built from WEBHOOK_URL and would say localhost:5678, which inside media-service means media-service. The split keeps the execution id and any ?signature= the resume URL carries."
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Wait for ingest",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [240, 0],
      "webhookId": "b1000000-0000-4000-8000-000000000003",
      "notes": "httpMethod is POST on purpose. The default is GET, and a POST callback to a GET-only resume webhook 404s — the execution then waits forever for a callback that already happened."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.body.state }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Ingest ok?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [460, 0]
    },
    {
      "parameters": {
        "assignments": {
