              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Ingest failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 100],
      "notes": "Reached because the service calls back on failure too. Without that this branch is unreachable and the execution simply never ends. F9 hangs the Telegram alert here."
