DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/dbname"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Local mode: no app login, no SaaS dependency. YouTube publishing via Google OAuth only.
LOCAL_MODE="true"
NEXT_PUBLIC_LOCAL_MODE="true"
LOCAL_USER_EMAIL="your_email@gmail.com"

# Optional: TikTok publishing via MuAPI. Leave empty to disable TikTok.
MUAPIAPP_API_KEY="your_muapi_api_key"
WEBHOOK_URL="your_webhook_url"
